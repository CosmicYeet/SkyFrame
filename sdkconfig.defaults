CONFIG_LV_MEM_CUSTOM=y
CONFIG_LV_MEM_CUSTOM_INCLUDE="skyframe_lvmem.h"
CONFIG_LV_MEMCPY_MEMSET_STD=y
CONFIG_LV_USE_USER_DATA=y
CONFIG_LV_USE_CHART=y
CONFIG_LV_USE_PERF_MONITOR=n
# Redraw at about the panel's ~65 Hz refresh so the radar sweep turns smoothly; a 1 ms
# FreeRTOS tick keeps the UI loop's timing that fine.
CONFIG_LV_DISP_DEF_REFR_PERIOD=15
CONFIG_FREERTOS_HZ=1000

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y

# ESP32-S3: 240 MHz, 8 MB octal PSRAM at 80 MHz. Code and constants run from PSRAM, which
# lets the panel's frame buffer (in PSRAM) be fetched at a higher pixel clock; 64-byte data
# cache lines suit the large sequential frame-buffer copies.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
# SkyFrame LVGL: fonts and TLS for HTTPS APIs
CONFIG_LV_FONT_MONTSERRAT_8=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_USE_QRCODE=y
CONFIG_LV_USE_DEMO_WIDGETS=n
CONFIG_LV_USE_DEMO_BENCHMARK=n
CONFIG_LV_USE_DEMO_STRESS=n
CONFIG_LV_USE_DEMO_MUSIC=n
CONFIG_LV_USE_DEMO_KEYPAD_AND_ENCODER=n
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
# TLS session buffers in PSRAM (internal RAM is too small for HTTPS + Wi-Fi + LCD),
# released after the handshake. Wi-Fi/lwIP buffers may also use PSRAM.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
# Precomputed P-256 tables in flash (~29 KB): ECDHE handshakes (every 20 s for traffic)
# run about 3-4 times faster on the curve maths; no RAM cost.
CONFIG_MBEDTLS_ECP_FIXED_POINT_OPTIM=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# A browser on the web pages keeps up to ~7 connections open; with the web server's own and
# mDNS, the default 10 left none for the HTTPS fetches (air traffic, weather).
CONFIG_LWIP_MAX_SOCKETS=16
# Network tasks run on CPU1; a TLS handshake there must not trip the idle watchdog.
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
# Unattended recovery: a stalled UI loop (or starved CPU0) restarts the device.
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# USB file transfer: the native USB port exposes the microSD card as a drive.
# The secondary USB-Serial-JTAG console would share that USB PHY, so it is off;
# the log stays on the UART port (CH343).
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_MSC_BUFSIZE=8192
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="SkyFrame"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="SkyFrame"
CONFIG_TINYUSB_DESC_MSC_STRING="SkyFrame SD card"

# The UI task (LVGL drawing; JPEG decoding is done by workers): ~4.8 KB used at most, measured
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240

# Per-core CPU use on the test-mode screen (idle task run time).
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

# Release build: LVGL drawing is much faster at -O2 than the debug default (-Og).
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Over-the-air updates: two firmware slots (partitions.csv), and a new version that doesn't
# prove itself (Wi-Fi joined, a minute of running) is rolled back at the next start.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# Updates must be signed with SkyFrame's key (RSA-3072). The key lives next to the project
# folder, never in the repository; every build is signed with it (the running firmware checks
# an update against its own signature's key, so USB-flashed builds must be signed too).
CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT=y
CONFIG_SECURE_SIGNED_APPS_RSA_SCHEME=y
CONFIG_SECURE_SIGNED_ON_UPDATE_NO_SECURE_BOOT=y
CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES=y
CONFIG_SECURE_BOOT_SIGNING_KEY="../SkyFrame-signing-key.pem"
# A crash is saved to the coredump partition; test mode shows a summary.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
# A missed bounce-buffer refill can't leave the picture shifted: the DMA restarts each vblank.
CONFIG_LCD_RGB_RESTART_IN_VSYNC=y
# TinyJPG built from source (32-bit fast decode, RGB565 out) instead of the older ROM copy.
CONFIG_JD_USE_ROM=n
CONFIG_JD_FORMAT_RGB565=y
